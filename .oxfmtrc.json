{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "ignorePatterns": [".astro/**", ".pi/**", "AGENTS.md", "dist/**", "node_modules/**"],
    "insertFinalNewline": true,
    "printWidth": 100,
    "proseWrap": "always",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false
}
