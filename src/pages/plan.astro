---
import { getCollection, getEntry, render } from "astro:content";
import Planner from "../components/planner";
import { order_expedition_catalog } from "../domain/expedition";

import BaseLayout from "../layouts/base_layout.astro";

const page = await getEntry("pages", "plan");
if (page === undefined) throw new Error("The required planner content entry is missing.");

const { Content } = await render(page);
const catalog = order_expedition_catalog(await getCollection("expeditions"))
    .map(({ id, data }) => ({ id, data }));
---

<BaseLayout title={page.data.title} description={page.data.description}>
    <header class="page-heading">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1>{page.data.title}</h1>
        <p>{page.data.description}</p>
    </header>
    <article class="prose">
        <Content />
    </article>
    <Planner client:only="react" catalog={catalog}>
        <p slot="fallback">
            Interactive planning requires JavaScript. If it does not load, reload this page or
            <a href="/expeditions">browse the static expedition collection</a>.
        </p>
    </Planner>
</BaseLayout>
