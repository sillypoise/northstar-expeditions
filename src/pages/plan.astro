---
import { getEntry, render } from "astro:content";

import BaseLayout from "../layouts/base_layout.astro";

const page = await getEntry("pages", "plan");
if (page === undefined) throw new Error("The required planner content entry is missing.");

const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
    <header class="page-heading">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1>{page.data.title}</h1>
        <p>{page.data.description}</p>
    </header>
    <article class="prose">
        <Content />
    </article>
    <p><a href="/expeditions">Browse the current expedition collection</a></p>
</BaseLayout>
