---
import { getCollection, render, type CollectionEntry } from "astro:content";

import {
    activity_labels,
    format_usd,
    order_expedition_catalog,
    season_labels,
} from "../../domain/expedition";
import BaseLayout from "../../layouts/base_layout.astro";

export async function getStaticPaths() {
    const expeditions = order_expedition_catalog(await getCollection("expeditions"));

    return expeditions.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

interface Props {
    readonly entry: CollectionEntry<"expeditions">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seasons = entry.data.seasons.map((season) => season_labels[season]).join(", ");
const activities = entry.data.activities.map((activity) => activity_labels[activity]).join(", ");
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
    <a class="back-link" href="/expeditions">← All expeditions</a>
    <header class="page-heading">
        <p class="eyebrow">{entry.data.region} · {entry.data.country}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
    </header>
    <dl class="metadata">
        <dt>Duration</dt>
        <dd>{entry.data.duration_days} days</dd>
        <dt>Difficulty</dt>
        <dd>{entry.data.difficulty}</dd>
        <dt>Seasons</dt>
        <dd>{seasons}</dd>
        <dt>Activities</dt>
        <dd>{activities}</dd>
        <dt>Route</dt>
        <dd>{entry.data.route.join(" → ")}</dd>
        <dt>Illustrative price</dt>
        <dd>{format_usd(entry.data.base_price_per_person_usd)} per person</dd>
    </dl>
    <section aria-labelledby="highlights-heading">
        <h2 id="highlights-heading">Highlights</h2>
        <ul>
            {entry.data.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
    </section>
    <p><a href={`/plan?version=1&step=season&expedition=${entry.id}`}>Plan this expedition</a></p>
    <article class="prose">
        <Content />
    </article>
</BaseLayout>
