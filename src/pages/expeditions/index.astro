---
import { getCollection, getEntry, render } from "astro:content";

import ExpeditionCard from "../../components/expedition_card.astro";
import DirectoryFilters from "../../components/directory_filters.astro";
import { order_expedition_catalog } from "../../domain/expedition";
import BaseLayout from "../../layouts/base_layout.astro";

const page = await getEntry("pages", "expeditions");
if (page === undefined) throw new Error("The required expeditions content entry is missing.");

const { Content } = await render(page);
const expeditions = order_expedition_catalog(await getCollection("expeditions"));
---

<BaseLayout title={page.data.title} description={page.data.description}>
    <header class="page-heading">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1>{page.data.title}</h1>
        <p>{page.data.description}</p>
    </header>
    <article class="prose">
        <Content />
    </article>
    <DirectoryFilters entries={expeditions} />
    <ul class="expedition-list">
        {
            expeditions.map((entry) => (
                <li data-expedition data-country={entry.data.country}
                    data-season={entry.data.seasons.join("|")}
                    data-duration={entry.data.duration_days <= 8 ? "short" : "long"}
                    data-activity={entry.data.activities.join("|")}>

                    <ExpeditionCard entry={entry} heading_level="h2" />
                </li>
            ))
        }
    </ul>
</BaseLayout>
